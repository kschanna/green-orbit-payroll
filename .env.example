SESSION_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg:///green_orbit_payroll

# Green Orbit AI Assistant
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Worker documents. Leave DOCUMENT_BUCKET unset for local filesystem storage.
DOCUMENT_STORAGE_PATH=.local/documents
# DOCUMENT_BUCKET=green-orbit-worker-documents
GOOGLE_CLOUD_PROJECT=green-orbit-payroll-demo
DOCUMENT_AI_LOCATION=australia-southeast1
DOCUMENT_AI_PROCESSOR_ID=replace-with-document-ai-processor-id
DOCUMENT_PROCESSING_SUBSCRIPTION=green-orbit-document-processing
COMPLIANCE_SCAN_SUBSCRIPTION=green-orbit-dev-compliance-scan-local
GREEN_ORBIT_TFN_KEY=generate-with-python-cryptography-fernet
